{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midnight.local/schemas/project-insight-feedback-response.schema.json",
  "title": "insights.recordInsightFeedback result",
  "type": "object",
  "required": ["version", "project", "recorded", "outcome"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "recorded": { "const": true },
    "outcome": { "type": "string", "enum": ["opened", "saved", "dismissed"] }
  }
}
